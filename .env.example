# Copy this file to .env (docker compose loads it automatically) and fill in
# real values before running `docker compose up -d`. .env is gitignored -
# never commit real secrets.

# Required: Postgres password, used by both the db and app containers.
DB_PASSWORD=

# Optional: host port the app is served on (default 80, so the app is
# reachable with no port suffix, e.g. http://moodtracker.local).
# APP_PORT=80

# Optional: SMTP relay for password-reset email - see README's "Forgot
# password" section. Leave unset and the app still runs fine; "Forgot your
# password?" just won't actually deliver mail.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM=no-reply@yourdomain.com
